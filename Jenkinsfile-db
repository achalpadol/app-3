pipeline {

    agent any

    parameters {
        choice(
            name: 'Environment',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Select deployment environment'
        )

        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'For QA/UAT/PROD enter the image tag created by DEV'
        )
    }

    environment {
        DB_IMAGE = 'achalpadol/app-3-db'

        DEV_NS  = 'app3-dev'
        QA_NS   = 'app3-qa'
        UAT_NS  = 'app3-uat'
        PROD_NS = 'app3-prod'

        AWS_REGION = 'ap-south-1'
        EKS_CLUSTER = 'achal-cluster-1'

        DOCKER_REGISTRY = 'https://index.docker.io/v1/'
        DOCKER_CREDENTIALS = '02_docker_hub_creds'
    }

    stages {

        stage('Validate Parameters') {
            steps {
                script {
                    echo "===================================="
                    echo "PARAMETER VALUES"
                    echo "Environment = [${params.Environment}]"
                    echo "IMAGE_TAG   = [${params.IMAGE_TAG}]"
                    echo "BUILD_NUMBER = [${env.BUILD_NUMBER}]"
                    echo "===================================="

                    if (!params.Environment) {
                        error("Environment parameter is empty")
                    }

                    if (params.Environment != 'dev') {
                        if (!params.IMAGE_TAG?.trim()) {
                            error(
                                "IMAGE_TAG is required for ${params.Environment}"
                            )
                        }
                    }
                }
            }
        }

        stage('Build Database Image - DEV') {
            when {
                expression {
                    params.Environment == 'dev'
                }
            }

            steps {
                script {

                    echo "Building database image..."

                    docker.build(
                        "${env.DB_IMAGE}:${env.BUILD_NUMBER}",
                        "-f ./db/Dockerfile ./db"
                    )
                }
            }
        }

        stage('Push Database Image - DEV') {
            when {
                expression {
                    params.Environment == 'dev'
                }
            }

            steps {
                script {

                    docker.withRegistry(
                        env.DOCKER_REGISTRY,
                        env.DOCKER_CREDENTIALS
                    ) {

                        def image = docker.image(
                            "${env.DB_IMAGE}:${env.BUILD_NUMBER}"
                        )

                        image.push()
                    }
                }
            }
        }

        stage('Deploy Database - DEV') {
            when {
                expression {
                    params.Environment == 'dev'
                }
            }

            steps {
                script {

                    echo "===================================="
                    echo "DEPLOY DATABASE - DEV"
                    echo "Environment = ${params.Environment}"
                    echo "Image       = ${env.DB_IMAGE}:${env.BUILD_NUMBER}"
                    echo "Namespace   = ${env.DEV_NS}"
                    echo "Cluster     = ${env.EKS_CLUSTER}"
                    echo "Region      = ${env.AWS_REGION}"
                    echo "===================================="

                    sh """
                        aws eks update-kubeconfig \
                          --region ${AWS_REGION} \
                          --name ${EKS_CLUSTER}

                        kubectl create namespace ${DEV_NS} \
                          --dry-run=client \
                          -o yaml | kubectl apply -f -

                        kubectl apply \
                          -f kube/backend-secret.yaml \
                          -f kube/configmap.yml \
                          -f kube/db-pvc.yml \
                          -f kube/db-service.yml \
                          -f kube/db-deploy.yml \
                          -n ${DEV_NS}

                        kubectl set image deployment/db \
                          db=${DB_IMAGE}:${BUILD_NUMBER} \
                          -n ${DEV_NS}

                        kubectl rollout status \
                          deployment/db \
                          -n ${DEV_NS} \
                          --timeout=5m

                        kubectl get deployment db -n ${DEV_NS}

                        kubectl get pods -n ${DEV_NS}
                    """
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }

        success {
            echo "Database deployment completed successfully."
        }

        failure {
            echo "Database deployment failed."
        }
    }
}
